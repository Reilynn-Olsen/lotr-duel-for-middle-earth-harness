OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional OpenRouter generation controls.
# OPENROUTER_REASONING_EFFORT=minimal
# OPENROUTER_MAX_TOKENS=4096

# Optional shell used to launch RULES_SERVER_COMMAND. Set this on minimal or
# Nix-based Linux hosts that do not provide /bin/sh.
# RULES_SERVER_SHELL=/path/to/bash
